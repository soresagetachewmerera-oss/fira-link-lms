releases/
*.apk
*.aab
*.tar.gz
*.tar
*.zip

# Logs
storage/logs/*
*.log

# Database
*.sqlite
image*.png

*.sqlite3
*.sqlite.bak
*.sqlite-shm
*.sqlite-wal
**/database/database.sqlite

# Next.js Web Frontend
fira-link-web/node_modules/
fira-link-web/.next/
fira-link-web/out/
fira-link-web/.pnpm-store/

# Secrets and signing (also covered by per-app .gitignore files)
**/key.properties
**/*.jks
**/*.keystore
**/google-services.json
**/GoogleService-Info.plist

# Local scripts (contain server credentials)
scratch/

# Laravel uploads and private storage (user documents, never commit)
firalink web/firalink/public/storage/
firalink web/firalink/storage/app/*
!firalink web/firalink/storage/app/.gitignore

# QA run reports (generated by qa/fira_qa.py)
qa/reports/
reports/
research_notes/
