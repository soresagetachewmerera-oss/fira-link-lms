APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Messaging: sender per message class (docs/messaging/email-delivery.md). Default: <class>@<MAIL_FROM_ADDRESS domain>.
MAIL_FROM_SECURITY=
MAIL_FROM_NO_REPLY=
MAIL_SUPPORT_ADDRESS=
MAIL_COMPANY_ADDRESS="Addis Ababa, Ethiopia"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payment Gateways
RAZORPAY_KEY=
RAZORPAY_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# PayPal Payment Gateway
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# SSLCommerz Payment Gateway
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_MODE=sandbox

# Mollie Payment Gateway
MOLLIE_KEY=test_...

# Chapa Payment Gateway
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-...
CHAPA_SECRET_KEY=CHASECK_TEST-...
# Off until the leaked Chapa keys are rotated. While off: no new Chapa checkout, webhooks refused, bank slips work.
CHAPA_ENABLED=false
# Webhook signing secret from the Chapa dashboard (falls back to the secret key). Webhooks without a signature are refused.
CHAPA_WEBHOOK_SECRET=
CHAPA_MODE=live

# SMS Ethiopia Messaging
SMS_ETHIOPIA_API_URL=https://api.sms-ethiopia.com/v1/send
SMS_ETHIOPIA_API_KEY=
SMS_ETHIOPIA_SENDER_ID=FiraLink
SMS_ETHIOPIA_ENABLED=true

# Google Gemini AI (Fira AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS=storage/app/firebase/firebase_credentials.json

# Verification (slice 3). ID_HASH_KEY: long random secret, never committed, never derived from APP_KEY.
ID_HASH_KEY=
VERIFICATION_ADMIN_EMAIL=
VERIFICATION_REVIEW_DAYS=3

# Samples (slice 6). Mock Chapa payment for samples: local and testing only, refused in production.
SAMPLE_PAYMENTS_MOCK=false

# QA tools (qa:seed, qa:code, qa:confirm-payment, qa:cleanup). Never in production.
# Staging only: QA_TOOLS_ENABLED=true. QA_PHONES = comma separated SIMs you own for phone sign-in tests.
QA_TOOLS_ENABLED=false
QA_PHONES=
